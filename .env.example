# ==========================================
# MediIntel - Environment Configuration Template
# ==========================================
# Copy this file to .env and configure your values.
# NEVER commit your actual .env file or real secrets to version control.

# ------------------------------------------
# Backend Server Configuration (Express)
# ------------------------------------------
PORT=5000
NODE_ENV=development

# Allowed CORS origins (comma-separated for multiple origins, or * for all)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------
# Frontend Configuration (Vite - prefixed with VITE_)
# ------------------------------------------
# Backend API Base URL
VITE_API_URL=http://localhost:5000

# Open-Meteo Weather API Base URL (free, no API key required)
VITE_WEATHER_API_URL=https://api.open-meteo.com/v1/forecast

# Application title
VITE_APP_TITLE=MediIntel Hospital Management System

# ------------------------------------------
# External Services & Optional API Keys
# ------------------------------------------
# If using proprietary Google Maps Platform tiles instead of OSM:
# VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Authentication / Session Secrets (if auth service is enabled)
# JWT_SECRET=your_super_secret_jwt_key_here
